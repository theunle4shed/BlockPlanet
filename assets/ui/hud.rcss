/* BlockPlanet's in-game HUD (docs/HUD_DESIGN.md): placeholder art until the
   owner's designs are in. Priority 1 in a container on the left, priority 2 in
   one on the right, each centred vertically beside the sphere (placed by
   ui_system.cpp); on portrait screens they are rows above and below.
   Sizes in dp, laid out for a 1080-pixel-high screen. */

body {
    width: 100%;
    height: 100%;
    font-family: LatoLatin;
    color: #f8f8f8;
    font-effect: outline(2dp #1a0c04);
    pointer-events: none;
}

div { display: block; }
#hud { width: 100%; height: 100%; }

/* The containers: tinted (the menus' colours), no border, round corners.
   The tint is on the groups, not the container, so the magic group can leave
   the item box clear. */
.side { position: absolute; }
#left { width: 232dp; }
#right { width: 248dp; text-align: right; }

.group, .rule, #magic .band, #magic .edge { background-color: #0b1020b0; }
.group { padding: 18dp 24dp; }
.side > :first-child { border-top-left-radius: 22dp; border-top-right-radius: 22dp; }
.side > :last-child { border-bottom-left-radius: 22dp; border-bottom-right-radius: 22dp; }

/* Dividers between groups: a thin light line across the tint. */
.rule { height: 2dp; background-color: #343a52e0; }

/* Hearts: three red tiles, a lost one dark. */
#hearts { height: 48dp; }
.heart {
    display: inline-block;
    width: 40dp;
    height: 40dp;
    margin-right: 10dp;
    border-radius: 12dp;
    background-color: #e02838;
    border: 3dp #f8f8f8;
}
.heart.lost { background-color: #20202880; border-color: #808080; }

/* Bars: a dark track with a fill. */
.bar {
    display: block;
    height: 16dp;
    background-color: #05081080;
    border: 2dp #f0f0f0a0;
    border-radius: 8dp;
}
.bar .fill {
    display: block;
    height: 100%;
    border-radius: 6dp;
    background-color: #38c8f0;
}

/* The drop timer, below the hearts; it turns red when time is short. */
#drop { width: 150dp; margin-top: 12dp; }
#drop .fill { background-color: #f5c21f; }
#drop.hurry .fill { background-color: #f04030; }

/* Magic: a clear window for the item (the game draws its 3D model there),
   framed by tinted bands, with the meter beneath. */
#magic .band { height: 14dp; }
#magic .band:last-child { height: auto; padding: 10dp 24dp 18dp 24dp; }
#magic .window { height: 136dp; }
#magic .edge { display: inline-block; width: 24dp; height: 136dp; vertical-align: top; }
#item {
    display: inline-block;
    vertical-align: top;
    width: 184dp;
    height: 132dp;
    border: 2dp #f0f0f040;
    border-radius: 18dp;
}
#item .name {
    display: block;
    padding-top: 50dp;
    text-align: center;
    font-size: 22dp;
    font-weight: bold;
    color: #f5821f;
}
#meter { width: 184dp; }
#meter .fill { background-color: #9c5cf0; }

/* Next pieces: the next one first and larger. */
.piece {
    display: block;
    position: relative;
    margin-bottom: 18dp;
}
.piece:last-child { margin-bottom: 0dp; }
.piece .cell {
    position: absolute;
    border-radius: 5dp;
    border: 2dp #00000060;
}
.piece .mystery {
    display: block;
    font-size: 48dp;
    font-weight: bold;
    color: #f5821f;
}

/* Right: mode and stage, the episode's time, progress. */
#mode { display: block; font-size: 30dp; color: #e8b818; }
#stage { display: block; font-size: 64dp; font-weight: bold; }
#time { font-size: 44dp; font-weight: bold; }
#progress { height: 20dp; }
#progress .fill { background-color: #48d060; }

/* Portrait (taller than wide): the containers become rows, the groups side by
   side with dividers between them. */
@media (orientation: portrait) {
    #left, #right { width: auto; text-align: left; }
    .side > div { display: inline-block; vertical-align: top; }
    .side > :first-child { border-radius: 0dp; border-top-left-radius: 22dp; border-bottom-left-radius: 22dp; }
    .side > :last-child { border-radius: 0dp; border-top-right-radius: 22dp; border-bottom-right-radius: 22dp; }
    .rule { width: 2dp; height: 120dp; padding: 18dp 0dp; }
    #lives, #next { height: 120dp; padding: 18dp 20dp; }
    #magic .band { height: 10dp; }
    #magic .window { height: 100dp; }
    #magic .edge { width: 16dp; height: 100dp; }
    #item { width: 120dp; height: 96dp; }
    #item .name { padding-top: 34dp; font-size: 18dp; }
    #meter { width: 120dp; }
    #magic .band:last-child { padding: 6dp 16dp 4dp 16dp; }
    #next .piece { display: inline-block; vertical-align: top; margin: 0dp 18dp 0dp 0dp; }
    #where, #time, #progress-group { height: 96dp; padding: 12dp 20dp; }
    #progress { width: 160dp; margin-top: 36dp; }
    #time { padding-top: 28dp; }
}
