/* Style: docs/STYLE.md (decided 2026-11-08). One set of roles for menus,
   HUD and cards: Hero 96, Display 64, Figure 44, Card 44, Item 40/34, Body 26,
   Note 24, Small 20; colours White #F8F8F8, Orange #F5821F, Yellow #E8B818,
   Gold #FFD23C (live feedback only), Term #86D8FF, Soft #C8D0E8, Muted #9AA6C8,
   Green #5AD46A, Red #F05A4A. Sizes in dp; Graphics > Text size multiplies
   every dp (ui_system.cpp), so the HUD and cards grow with the menus. */
/* BlockPlanet's in-game HUD (docs/HUD_DESIGN.md): placeholder art until the
   owner's designs are in. Priority 1 in a container on the left, priority 2 in
   one on the right, each centred vertically beside the sphere (placed by
   ui_system.cpp); on portrait screens they are rows above and below.
   Sizes in dp, laid out for a 1080-pixel-high screen. */

body {
    width: 100%;
    height: 100%;
    font-family: LatoLatin;
    color: #f8f8f8;
    font-effect: outline(1dp #1a0c04);
    pointer-events: none;
}

div { display: block; }
#hud { width: 100%; height: 100%; transition: opacity 0.2s cubic-out; }
/* Under the game's end menus (game over, Versus' end) the panels fade out. */
#hud.ended { opacity: 0; }
/* The game's own text and the cards, above the panels and never faded. */
#game-text { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
/* Digits of a changing number, each in a box of one width (Lato's figures
   are proportional, so a clock would jiggle). */
.d { display: inline-block; width: 0.5em; text-align: center; }

/* The containers: tinted (the menus' colours), no border, round corners.
   The tint is on the groups, not the container, so the magic group can leave
   the item box clear. */
.side { position: absolute; }
/* Both 248dp, so every bar, the item box and the dividers are 200dp wide,
   the width inside the groups' padding (the owner, 2026-11-19: the same widths
   throughout). */
#left { width: 248dp; }
#right { width: 248dp; text-align: right; }

.group, .rule, #magic .band, #magic .edge { background-color: #0b1020c0; }
.group { padding: 16dp 24dp 20dp 24dp; }

/* Floating numbers: points rising from where blocks cleared. */
#popups { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.popup {
    position: absolute;
    width: 400dp;
    text-align: center;
    transform-origin: 50% 50%;
}
.popup .points {
    display: block;
    font-size: 44dp;
    font-weight: bold;
    color: #ffd23c;
    font-effect: outline(3dp #3a1a04);
}
.popup .note {
    display: block;
    font-size: 24dp;
    font-weight: bold;
    color: #f8f8f8;
    font-effect: outline(2dp #1a0c04);
}

/* Section titles, for new and returning players. */
.label {
    display: block;
    font-size: 20dp;
    font-weight: bold;
    color: #9aa6c8;
    margin-bottom: 8dp;
    font-effect: none;
}
.side > :first-child { border-top-left-radius: 24dp; border-top-right-radius: 24dp; }
.side > :last-child { border-bottom-left-radius: 24dp; border-bottom-right-radius: 24dp; }
/* Magic as the last group (Lines has no queue): its tinted bands carry the corners. */
#magic:last-child .band:last-child { border-bottom-left-radius: 24dp; border-bottom-right-radius: 24dp; }

/* Dividers between groups: a thin light line across the tint, with room
   either side. */
.rule { padding: 10dp 24dp; }
.rule .line { height: 2dp; background-color: #3a4260; }

/* Hearts: three red hearts with a white border, a lost one dark (the owner,
   2026-11-18: hearts like the original's, in place of square tiles; drawn by
   tools/art/hearts.py). */
#hearts, .hearts { height: 48dp; }
.heart {
    display: inline-block;
    width: 44dp;
    height: 44dp;
    margin-right: 8dp;
    decorator: image(/blockplanet-ui/hearts/heart.png);
}
.heart.lost { decorator: image(/blockplanet-ui/hearts/heart-lost.png); }

/* Bars: a dark track with a fill. */
.bar {
    display: block;
    height: 16dp;
    background-color: #05081080;
    border: 2dp #f0f0f0a0;
    border-radius: 8dp;
}
.bar .fill {
    display: block;
    height: 100%;
    border-radius: 6dp;
    background-color: #38c8f0;
}

/* The drop timer, below the hearts: a bar in thirds (split where the game's
   warning ticks start), green, then amber, then red, with a marker at the
   fill's edge (ui_system.cpp, drop_bar). */
#drop { margin-top: 12dp; }
.drop-bar { position: relative; }
.drop-bar .fill { background-color: #4cc860; }
.drop-bar.third-2 .fill { background-color: #f5c21f; }
.drop-bar.third-3 .fill { background-color: #f05a4a; }
.drop-bar .notch { position: absolute; top: -2dp; width: 2dp; height: 20dp; margin-left: -1dp; background-color: #f0f0f0a0; }
.drop-bar .needle { position: absolute; top: -5dp; width: 4dp; height: 26dp; margin-left: -2dp; border-radius: 2dp; background-color: #ffffff; }
/* A warning: the bar flashes white twice (the owner, 2026-11-19, in place of
   the original's flashing light). */
.drop-bar.blink { animation: 0.16s linear-in-out 4 alternate drop-blink; }
@keyframes drop-blink { from { background-color: #05081080; border-color: #f0f0f0a0; } to { background-color: #ffffffe0; border-color: #ffffff; } }
/* The seconds to the drop, beside the Health label while the piece falls. */
#drop-count { float: right; font-size: 22dp; font-weight: bold; color: #f5c21f; font-effect: none; }
#drop-count.phase-2 { color: #f05a4a; }
#drop-count.calm { display: none; }

/* Magic: one box for the held magic that also charges up as the meter fills
   (the owner, 2026-11-19: the box and bar merged, rounded like the bars, the
   timer bar's width). The game draws the magic's 3D model there, and its tint
   behind it (magic_hooks.cpp), so the box is clear while a model is held and
   the game draws the charge too, behind the model; otherwise the charge is
   this translucent purple from the bottom. */
#magic .band { height: auto; padding: 16dp 24dp 0dp 24dp; }
#magic .band.foot { height: 20dp; padding: 0dp; }
#magic .side-meter #meter-v { display: none; }
#magic .window { height: 136dp; white-space: nowrap; }
#magic .edge { display: inline-block; width: 24dp; height: 136dp; vertical-align: top; }
/* 24 + 200 (196 + a 2dp border each side) + 24 = the container's 248dp. */
#item {
    display: inline-block;
    position: relative;
    vertical-align: top;
    width: 196dp;
    height: 132dp;
    border: 2dp #f0f0f0a0;
    border-radius: 8dp;
    background-color: #0b1020ff;  /* solid, as the game-drawn tint behind a held magic */
}
#item.held { background-color: transparent; }
#item-fill {
    position: absolute;
    left: 0dp;
    bottom: 0dp;
    width: 100%;
    height: 0%;
    border-radius: 6dp;
    background-color: #9c5cf040;  /* no edge line (the owner, 2026-11-19) */
}
#item.full { border-color: #c9a2ff; }
#item .name {
    position: absolute;
    left: 0dp;
    top: 50dp;
    width: 100%;
    text-align: center;
    font-size: 24dp;
    font-weight: bold;
    color: #f5821f;
}

/* Next pieces: centred in the panel (the owner, 2026-11-19). */
#next .piece { margin-left: auto; margin-right: auto; }

/* Puzzle: drops and slides left, large. */
.count { display: block; font-size: 64dp; font-weight: bold; line-height: 68dp; }

/* Next pieces: the next one first and larger. */
.piece {
    display: block;
    position: relative;
    margin-bottom: 18dp;
}
.piece:last-child { margin-bottom: 0dp; }
.piece .cell {
    position: absolute;
    border-radius: 5dp;
    border: 2dp #00000060;
}
.piece .random-block {
    display: block;
    font-size: 44dp;
    font-weight: bold;
    color: #f5821f;
}

/* Right: mode and stage, the episode's time, progress. */
#where .label { color: #e8b818; font-size: 24dp; }
#stage { display: block; font-size: 64dp; font-weight: bold; }
#stage.word { font-size: 40dp; line-height: 52dp; }
#stage.word.long { font-size: 28dp; line-height: 40dp; }
#time { display: block; font-size: 44dp; font-weight: bold; }
/* Time Trial: the clock (red and pulsing in the last 30 seconds) and the score. */
#clock { display: block; font-size: 44dp; font-weight: bold; }
#clock.low { color: #f05a4a; animation: 0.5s sine-in-out infinite alternate pulse; }
@keyframes pulse { from { opacity: 1; } to { opacity: 0.55; } }
#score { display: block; font-size: 40dp; font-weight: bold; }
#score-best { display: block; font-size: 20dp; color: #c8d0e8; margin-top: 4dp; }
.clock-inline { display: none; }

/* Differences against best times: green ahead, red behind. */
.ahead { color: #5ad46a; }
.behind { color: #f05a4a; }
/* Story: the combo counter, live while it builds; gold at 20 or more (magic). */
#combo { display: block; font-size: 44dp; font-weight: bold; color: #f8f8f8; }
#combo-group.live #combo { color: #ffd23c; }
#combo-group.magic #combo { color: #ffd23c; font-effect: glow(1dp 6dp 0dp 0dp #ffb01899); }
#combo-magic { display: block; font-size: 20dp; font-weight: bold; color: #ffd23c; }
#combo-best { display: block; font-size: 20dp; color: #9aa6c8; margin-top: 2dp; }
/* Story: the last five points added, under the score, newest first. */
#gains { display: block; margin-top: 6dp; }
/* Story: room for the last five gains and the newest one's kind line, always,
   so the panel keeps one height (the owner, 2026-11-18). */
#story-score #gains { height: 144dp; overflow: hidden; }
#gains .gain { display: block; font-size: 20dp; color: #9aa6c8; }
#gains .gain.newest { font-size: 20dp; color: #e8b818; }
/* A combo still building (Story's merged combo and score): larger, glowing. */
#gains .gain.newest.live { font-size: 24dp; font-weight: bold; color: #ffd23c; font-effect: glow(1dp 6dp 0dp 0dp #ffb01899); }
#story-score #combo-best { display: block; font-size: 17dp; color: #9aa6c8; margin-top: 4dp; }
#gains .gain-kind { display: block; font-size: 15dp; color: #86d8ff; margin-bottom: 2dp; }
#best { display: block; font-size: 20dp; color: #c8d0e8; margin-top: 6dp; }
#net { display: block; font-size: 26dp; font-weight: bold; margin-top: -2dp; }
/* Splits, LiveSplit style: stage, difference, time; the current one highlighted. */
#splits { display: block; margin-top: 12dp; }
.split { display: block; font-size: 20dp; line-height: 28dp; color: #c8d0e8; white-space: nowrap; }
.split .stage { display: inline-block; width: 52dp; white-space: nowrap; text-align: left; color: #9aa6c8; }
.split .delta { display: inline-block; width: 70dp; text-align: right; font-weight: bold; }
.split .t { display: inline-block; width: 80dp; text-align: right; }
.split.current { color: #f8f8f8; font-weight: bold; }
.split.current .stage { color: #e8b818; }
#progress { height: 18dp; }
#where .sublabel { display: block; font-size: 20dp; font-weight: bold; color: #9aa6c8; font-effect: none; margin: 8dp 0dp 6dp 0dp; }
#progress .fill { background-color: #5ad46a; }
/* Hide & Seek: the level's goal, in words. */
#goal { display: block; font-size: 26dp; font-weight: bold; color: #f8f8f8; }

/* VS: a narrower column per player at the outer edges. */
.side.versus { width: 176dp; }
.versus .group { padding: 12dp 18dp 14dp 18dp; }
.versus .label { font-size: 20dp; margin-bottom: 6dp; }
.versus .heart { width: 34dp; height: 34dp; margin-right: 6dp; }
.versus .hearts { height: 38dp; }
.versus .count { font-size: 44dp; line-height: 48dp; }
.versus .rule { padding: 6dp 14dp; }
#right.versus { text-align: right; }
.vs-drop { width: 128dp; margin-top: 8dp; }
#right .vs-drop { margin-left: auto; }
.vs-item { display: block; height: 30dp; font-size: 24dp; font-weight: bold; color: #f5821f; }
.vs-meter { margin-top: 8dp; }
.vs-meter .fill { background-color: #9c5cf0; }
#right.versus .piece { margin-left: auto; }

/* Portrait (taller than wide): the containers become rows, the groups side by
   side with dividers between them. */
@media (orientation: portrait) {
    /* Every section is 136dp tall (padding included), so the row's tint is
       even; the magic meter is a column beside the item box, filling upwards,
       so the row stays thin. */
    #left, #right { width: auto; text-align: left; white-space: nowrap; }
    .side > div { display: inline-block; vertical-align: top; }
    .side > :first-child { border-radius: 0dp; border-top-left-radius: 24dp; border-bottom-left-radius: 24dp; }
    .side > :last-child { border-radius: 0dp; border-top-right-radius: 24dp; border-bottom-right-radius: 24dp; }
    .group { height: 122dp; padding: 14dp 20dp 0dp 20dp; }
    .rule { padding: 14dp 10dp; height: 108dp; }
    .rule .line { width: 2dp; height: 108dp; }
    #magic .band { height: auto; padding: 14dp 16dp 0dp 16dp; }
    #magic .band.foot { height: 3dp; padding: 0dp; }
    #magic .window { height: 86dp; }
    #magic .edge { width: 16dp; height: 86dp; }
    #item { width: 116dp; height: 82dp; }
    #item .name { top: 32dp; font-size: 20dp; }
    #next .piece { display: inline-block; vertical-align: top; margin: 0dp 18dp 0dp 0dp; }
    #stage { font-size: 40dp; line-height: 44dp; }
    #time { font-size: 40dp; }
    #where .sublabel { display: none; }
    #goal { font-size: 24dp; margin-top: 4dp; }
    /* Rescue's clear target beside the stage, so the row keeps its height. */
    #where.clear #stage { display: inline-block; }
    #where.clear #goal { display: inline-block; margin: 0dp 0dp 0dp 14dp; }
    .count { font-size: 44dp; line-height: 52dp; }
    #progress { width: 120dp; margin-top: 8dp; height: 14dp; }
    #net { display: inline-block; margin-left: 12dp; }
    #time { display: inline-block; }
    #clock-group, #clock-rule { display: none; }
    .clock-inline { display: block; font-size: 26dp; font-weight: bold; margin-top: 6dp; }
    .clock-inline.low { color: #f05a4a; }
    #score { font-size: 34dp; }
    #splits { margin-top: 2dp; }
    .split { display: none; font-size: 20dp; line-height: 24dp; }
    .split:last-child, .split.last-done { display: block; }
}

/* The title screen: the original game's notice and BlockPlanet's disclaimer. */
#title-notice { position: absolute; text-align: center; font-effect: outline(2dp #05081a); }
#title-notice .notice { display: block; font-size: 24dp; line-height: 30dp; color: #4fb3d0; letter-spacing: 1dp; }
#title-notice .disclaimer { display: block; margin-top: 8dp; font-size: 20dp; line-height: 24dp; color: #9aa6c8; }
@media (orientation: portrait) {
    /* The title's notice on narrow screens: smaller, one line each. */
    #title-notice .notice { font-size: 13dp; line-height: 17dp; letter-spacing: 0dp; }
    #title-notice .disclaimer { font-size: 11dp; line-height: 14dp; margin-top: 5dp; }
}

/* The game's own text in BlockPlanet's font, placed as the game placed it. */
.game-text {
    position: absolute;
    white-space: nowrap;
    font-weight: bold;
    font-effect: outline(2dp #1a0c04);
}

/* Button symbols in the game's text (ui_system.cpp, with_buttons). Sized in
   em, so they follow the text. */
.btn {
    display: inline-block;
    min-width: 1.15em;
    height: 1.15em;
    line-height: 1.15em;
    padding: 0em 0.12em;
    margin: 0em 0.08em;
    text-align: center;
    font-size: 0.8em;
    font-weight: bold;
    color: #f8f8f8;
    font-effect: none;
    vertical-align: middle;
}
.btn.key { border: 0.1em #e8e8f0; border-radius: 0.25em; background-color: #2a2e3c; padding: 0em 0.3em; }
.btn.pad { border-radius: 0.6em; }
.btn.shoulder { background-color: #2a2c34; border: 0.08em #b8bcc8; border-radius: 0.35em 0.35em 0.2em 0.2em; padding: 0em 0.3em; }
.btn.nx { background-color: #3a3c44; border: 0.08em #d8d8e0; }
.btn.ps { background-color: #1e2028; border: 0.08em #9098b0; position: relative; width: 1.15em; padding: 0em; }
.ps-cross, .ps-circle, .ps-square, .ps-triangle { display: block; position: absolute; }
/* The d-pad: a light cross on a dark cap. */
.btn.dpad { background-color: #2a2c34; border: 0.08em #b8bcc8; position: relative; width: 1.15em; padding: 0em; }
.dpad-cross { display: block; position: absolute; left: 0.2em; top: 0.2em; width: 0.75em; height: 0.75em; }
.dpad-cross .arm { display: block; position: absolute; background-color: #e8ecf6; border-radius: 0.05em; }
.dpad-cross .arm.h { left: 0em; top: 0.27em; width: 0.75em; height: 0.21em; }
.dpad-cross .arm.v { left: 0.27em; top: 0em; width: 0.21em; height: 0.75em; }
/* The stick: a round dark cap with a lighter ring and its name (L). */
.btn.stick { background-color: #1e2028; border: 0.1em #b8bcc8; border-radius: 0.6em; width: 1.15em; padding: 0em; font-size: 0.7em; }
/* The arrow keys: a key cap holding a four-way arrow (the icon font's "move"). */
.btn.arrows { font-family: lucide; font-weight: normal; font-style: normal; padding: 0em 0.15em; }
.ps-cross { left: 0.22em; top: 0.22em; width: 0.7em; height: 0.7em; }
.ps-cross .bar { display: block; position: absolute; left: 0em; top: 0.3em; width: 0.7em; height: 0.12em; background-color: #7aa8ff; }
.ps-cross .bar.a { transform: rotate(45deg); }
.ps-cross .bar.b { transform: rotate(-45deg); }
.ps-circle { left: 0.27em; top: 0.27em; width: 0.45em; height: 0.45em; border: 0.1em #ff6680; border-radius: 0.35em; }
.ps-square { left: 0.3em; top: 0.3em; width: 0.42em; height: 0.42em; border: 0.1em #e080d0; }
.ps-triangle { left: 0.25em; top: 0.3em; width: 0em; height: 0em; border-left: 0.32em transparent; border-right: 0.32em transparent; border-bottom: 0.52em #40c8a0; border-top: 0em transparent; }

/* A card's panel in the menus' style (Training's speech bubble, replaced):
   the menus' tint and white rim, holding its text, growing upwards from its
   bottom edge. The tail is a square turned 45 degrees with the rim on two
   sides, half inside the panel, so panel and tail read as one shape. */
.card-panel {
    position: absolute;
    padding: 0.7em 0.95em 0.35em 0.95em;
    background-color: #0b1020f0;
    border: 3dp #f0f0f0;
    border-radius: 24dp;
    font-effect: none;
    white-space: normal;
    font-size: 44dp;  /* Card: one size for every card and Wheels' speech */
    line-height: 1.32;
}
.card-heading {
    display: block;
    font-weight: bold;
    font-size: 1em;
    margin-bottom: 0.35em;
}
.card-body {
    display: block;
    font-style: italic;
    font-weight: normal;
}
.card-body .hl { font-weight: bold; }
/* A game term where Wheels or a card introduces it: a soft glow. */
.card-body .hl.new { font-effect: glow(1dp 4dp 0dp 0dp #3fa8ff90); }
.card-hint {
    display: block;
    text-align: left;  /* the tail is under the right of the bottom edge */
    color: #e8b818;
    font-weight: normal;
    font-size: 0.6em;
    margin-top: 2.2em;  /* well clear of the text above (the owner: more space before the prompts) */
}
.card-tail {
    position: absolute;
    margin-left: -28dp;
    margin-bottom: -28dp;
    width: 56dp;
    height: 56dp;
    background-color: #0b1020f0;
    border-right: 3dp #f0f0f0;
    border-bottom: 3dp #f0f0f0;
    transform: rotate(45deg);
}
.card-scroll {
    display: block;
    overflow-y: hidden;  /* scrolled by BlockPlanet (right stick, Page Up / Down, wheel) */
}

/* Training: one row along the bottom (as the portrait rows), holding only
   what Wheels has introduced. A part just introduced glows for a moment. */
#left.row { width: auto; text-align: left; transform: scale(1.3); transform-origin: 50% 100%; }
#left.row > div { display: inline-block; vertical-align: top; }
#left.row > :first-child { border-radius: 0dp; border-top-left-radius: 24dp; border-bottom-left-radius: 24dp; }
#left.row > :last-child { border-radius: 0dp; border-top-right-radius: 24dp; border-bottom-right-radius: 24dp; }
/* One group alone (Training's Next at first): rounded at both ends (the
   last-child rule above would square its left end). */
#left.row > :only-child { border-radius: 24dp; }
/* Next keeps room for three pieces, so the row does not change width with
   the number of shapes a lesson uses (the owner, 2026-11-20). */
#left.row #next { min-width: 300dp; }
#left.row #next.compact { min-width: 0dp; }  /* a lesson showing one piece: the box only that wide */
#left.row .group { height: 122dp; padding: 14dp 20dp 0dp 20dp; }
#left.row .rule { padding: 14dp 10dp; height: 108dp; }
#left.row .rule .line { width: 2dp; height: 108dp; }
#left.row #magic .band { height: auto; padding: 14dp 16dp 0dp 16dp; }
#left.row #magic .band.foot { height: 3dp; padding: 0dp; }
#left.row #magic .window { height: 86dp; }
#left.row #magic .edge { width: 16dp; height: 86dp; }
#left.row #item { width: 116dp; height: 82dp; }
#left.row #item .name { top: 32dp; font-size: 20dp; }
#left.row #next .piece { display: inline-block; vertical-align: top; margin: 0dp 18dp 0dp 0dp; }
#left.row #progress { width: 160dp; margin-top: 18dp; height: 14dp; }
#left.row .count { font-size: 44dp; line-height: 52dp; }
#left.row .intro { background-color: #e8b81838; }
#left.row .intro .label { color: #e8b818; }
.card-para + .card-para, .card-para + .card-heading { margin-top: 0.55em; }

/* Minefield on the sphere: each cell's number, flag or mine, over the cell. */
.mark { position: absolute; width: 80dp; height: 60dp; line-height: 60dp; text-align: center;
        font-size: 40dp; font-weight: bold; color: #f8f8f8; font-effect: outline(3dp #000000c0); }
.mark.n1 { color: #50a8f0; }
.mark.n2 { color: #6ed36a; }
.mark.n3 { color: #f06060; }
.mark.n4 { color: #b090f8; }
.mark.n5 { color: #f2b030; }
.mark.n6 { color: #3fc8b8; }
.mark.n7 { color: #f070a8; }
.mark.n8 { color: #c8c8c8; }
.mark.flag, .mark.mine, .mark.hit, .mark.found { font-family: lucide; font-weight: normal; font-size: 34dp; }
.mark.flag { color: #f5821f; }
.mark.mine { color: #f06060; }
.mark.hit { color: #ffffff; font-size: 52dp; }
.mark.found { color: #6ed36a; }
