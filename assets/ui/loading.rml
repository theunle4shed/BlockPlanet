<rml>
<head>
    <title>Loading</title>
    <style>
        body { width: 100%; height: 100%; background-color: #070a14; font-family: Lato; color: #f0f2f8; }
        #loading-mode { position: absolute; left: 0; right: 0; top: 42%; text-align: center; font-size: 6vh; font-weight: bold; color: #e8b818; }
        #loading-note { position: absolute; left: 0; right: 0; top: 52%; text-align: center; font-size: 2.6vh; color: #9aa6c8; }
        /* Over the menu grid as the loading screen: the text alone, outlined. */
        body.on-grid { background-color: #00000000; }
        body.on-grid #loading-mode, body.on-grid #loading-note { font-effect: outline(0.35vh #05080e); }
    </style>
</head>
<body>
    <div id="loading-mode"></div>
    <div id="loading-note">Loading</div>
</body>
</rml>
