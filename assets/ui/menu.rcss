/* BlockPlanet menus: placeholder layout until the art direction is set
   (docs/UI.md), in the original game's menu colours: orange items, the
   selected one white, dark-outlined text, a white-outlined box and yellow
   hints. Sizes are in dp, laid out for a 1080-pixel-high screen. */

body {
    width: 100%;
    height: 100%;
    font-family: LatoLatin;
    color: #f8f8f8;
    background-color: #05081080;
    font-effect: outline(2dp #1a0c04);
}

@keyframes enter {
    from { opacity: 0; transform: translateX(48dp); }
    to { opacity: 1; transform: translateX(0dp); }
}
@keyframes return {
    from { opacity: 0; transform: translateX(-48dp); }
    to { opacity: 1; transform: translateX(0dp); }
}
body.entering #panel { animation: 0.18s cubic-out enter; }
body.returning #panel { animation: 0.18s cubic-out return; }

#panel {
    position: absolute;
    left: 120dp;
    top: 60dp;
    width: 720dp;
    padding: 48dp 56dp;
    background-color: #0b1020d0;
    border: 3dp #f0f0f0;
    border-radius: 28dp;
}

.title {
    display: block;
    font-size: 72dp;
    font-weight: bold;
}
/* "BlockPlanet v0.1" under the main menu's title. */
.version {
    display: block;
    font-size: 24dp;
    color: #a8b0c8;
    margin-top: -4dp;
    margin-bottom: 12dp;
}
.subtitle {
    display: block;
    font-size: 28dp;
    color: #e8b818;
    margin-bottom: 24dp;
}

.item {
    display: block;
    font-size: 44dp;
    padding: 10dp 28dp;
    margin-bottom: 4dp;
    border-radius: 14dp;
    transition: background-color 0.12s cubic-out;
}
/* Items in the original orange; the selected one turns white. */
.item { color: #f5821f; }  /* the original #E06018, brightened a little */
.item.focused {
    color: #f8f8f8;
    background-color: #ffffff1a;
    font-weight: bold;
}
.item .note {
    font-size: 24dp;
    color: #e8b818;
    margin-left: 16dp;
    font-weight: normal;
}
.item.focused .note { color: #e8b818; }

.hint {
    display: block;
    margin-top: 32dp;
    font-size: 24dp;
    color: #e8b818;
}

/* Setting rows: label on the left, value on the right. */
.item.value .value {
    float: right;
    color: #e8b818;
}
.item.value.focused .value { color: #f8f8f8; }

/* Long lists scroll inside the panel. */
.list {
    display: block;
    width: 100%;          /* full width, so names do not wrap */
    max-height: 52vh;     /* fits smaller windows; the rest scrolls */
    overflow-y: auto;
}
/* The scrollbar of a long list: a thin orange bar on a faint track. */
scrollbarvertical { width: 8dp; margin-left: 8dp; }
scrollbarvertical slidertrack { background-color: #ffffff14; border-radius: 4dp; }
scrollbarvertical sliderbar { background-color: #f5821fcc; border-radius: 4dp; min-height: 32dp; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { width: 0dp; height: 0dp; }

/* A wider panel, for the name screen's keyboard. */
#panel.wide { width: 860dp; }

/* The name being typed, with a caret. */
.name-field {
    display: block;
    font-size: 56dp;
    font-weight: bold;
    padding: 12dp 24dp;
    margin-bottom: 8dp;
    border-radius: 14dp;
    background-color: #ffffff14;
    min-height: 68dp;
}
.name-field-hint {
    display: block;
    font-size: 24dp;
    color: #e8b818;
    margin-bottom: 20dp;
    min-height: 30dp;
}

/* Grids (data-columns): keys side by side, sized as shares of the row so
   each row holds exactly the grid's column count; wide keys (span2, span4)
   take that many columns. */
.keys .item {
    display: inline-block;
    width: 8%;
    padding: 10dp 0dp;
    margin: 0dp 1.8% 8dp 0dp;
    text-align: center;
    font-size: 34dp;
    background-color: #ffffff0c;
}
.keys .item.focused { background-color: #ffffff26; }
.keys .item.span2 { width: 17.8%; font-size: 26dp; padding: 17dp 0dp; }
.keys .item.span4 { width: 37.4%; font-size: 26dp; padding: 17dp 0dp; }
.keys .item.span2, .keys .item.span4 { margin-top: 8dp; }
.tiles .item {
    display: inline-block;
    box-sizing: border-box;
    width: 31%;
    margin-right: 2%;
}
.tiles .item {
    vertical-align: top;
    height: 92dp;
    font-size: 40dp;
}
.tiles .item .note {
    display: block;
    margin-left: 0dp;
    font-size: 22dp;
}

/* Controller-only and keyboard-only parts (body.pad while a controller is used). */
.for-pad { display: none; }
body.pad .for-pad { display: block; }
body.pad .for-keys { display: none; }
.subtitle .for-pad, .subtitle .for-keys { display: inline; }
.subtitle .for-pad { display: none; }
body.pad .subtitle .for-pad { display: inline; }

/* Over the game's own pause background, which already hides the board. */
body.over-pause { background-color: #00000000; }

/* A large heading, for screens shown over play (the pause menu). */
.header {
    display: block;
    font-size: 96dp;
    font-weight: bold;
    letter-spacing: 12dp;
    margin-bottom: 4dp;
}

/* Sliders: a bar beside the value, filled to it (placed absolutely, as
   floats beside the value do not line up in RmlUi). */
.item.slider { position: relative; }
.item.slider .value {
    float: none;
    position: absolute;
    right: 28dp;
    top: 10dp;
}
.item.slider .bar {
    position: absolute;
    right: 150dp;
    top: 31dp;
    width: 200dp;
    height: 10dp;
    border-radius: 5dp;
    background-color: #ffffff26;
}
.item.slider .fill {
    display: block;
    height: 10dp;
    border-radius: 5dp;
    background-color: #f5821f;
}
.item.slider.focused .fill { background-color: #f8f8f8; }

/* Section headings inside a screen (Options: Graphics, Audio). */
.section {
    display: block;
    font-size: 24dp;
    font-weight: bold;
    letter-spacing: 3dp;
    color: #e8b818;
    padding: 6dp 28dp 4dp 28dp;
    margin-top: 10dp;
    border-bottom: 1dp #ffffff33;
    margin-bottom: 6dp;
}

/* What the focused item is (data-description), under the list. */
.description {
    display: block;
    margin-top: 24dp;
    padding: 16dp 28dp;
    min-height: 64dp;
    font-size: 26dp;
    line-height: 34dp;
    color: #c8d0e8;
    font-effect: none;
    background-color: #ffffff0d;
    border-radius: 14dp;
}
.description.empty { visibility: hidden; }
/* Chapter and stage lists: no empty description box under the list. */
body.lists .description.empty { display: none; }

/* The Alt button's hint at the end of a description ("[X] Training"). */
.alt-hint { display: block; margin-top: 8dp; color: #f2c14e; }

/* Button symbols, as in the HUD's game text (hud.rcss). */
.btn {
    display: inline-block;
    min-width: 1.15em;
    height: 1.15em;
    line-height: 1.15em;
    padding: 0em 0.12em;
    margin: 0em 0.08em;
    text-align: center;
    font-size: 0.8em;
    font-weight: bold;
    color: #f8f8f8;
    font-effect: none;
    vertical-align: middle;
}
.btn.key { border: 0.1em #e8e8f0; border-radius: 0.25em; background-color: #2a2e3c; padding: 0em 0.3em; }
.btn.pad { border-radius: 0.6em; }
.btn.shoulder { background-color: #2a2c34; border: 0.08em #b8bcc8; border-radius: 0.35em 0.35em 0.2em 0.2em; padding: 0em 0.3em; }
.btn.nx { background-color: #3a3c44; border: 0.08em #d8d8e0; }
.btn.ps { background-color: #1e2028; border: 0.08em #9098b0; position: relative; width: 1.15em; padding: 0em; }
.ps-cross, .ps-circle, .ps-square, .ps-triangle { display: block; position: absolute; }

/* Long lists (the main menu): smaller rows so the description fits. */
body.compact #panel { top: 40dp; padding: 40dp 56dp; }
body.compact .item { font-size: 38dp; padding: 6dp 28dp; margin-bottom: 2dp; }
body.compact .subtitle { margin-bottom: 16dp; }

/* How to Play (pause menu): short paragraphs to read. */
.howto { display: block; margin: 12dp 0dp 20dp 0dp; }
.howto .para { display: block; font-size: 24dp; line-height: 34dp; color: #dfe3ee; margin-bottom: 10dp; }
