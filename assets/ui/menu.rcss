/* Style: docs/STYLE.md (decided 2026-11-08), shared with the HUD and cards
   (hud.rcss). Every menu text uses one of these roles; sizes in dp, laid out
   for a 1080-pixel-high screen. Graphics > Text size multiplies every dp
   (ui_system.cpp), so whole panels grow evenly.
     Hero      96  bold   the pause menu's Paused (.header)
     Display   64  bold   screen titles (.title)
     Item      40         menu choices (.item); 34 in long lists (body.compact)
     Body      26         descriptions and paragraphs (.description, .howto .para);
                          subtitles in Yellow (.subtitle)
     Note      24         notes beside items, values, hints, the version
   Special cases: the name being typed (56) and the on-screen keyboard (34).
   Colours: items Orange #F5821F, the focused one White #F8F8F8 on a pill
   (no change of weight); notes, values, subtitles and hints Yellow #E8B818;
   descriptions Soft #C8D0E8; the version Muted #9AA6C8. Text inside the
   panel has no outline. */

body {
    width: 100%;
    height: 100%;
    font-family: LatoLatin;
    color: #f8f8f8;
    background-color: #05081080;
    font-effect: none;
}

@keyframes enter {
    from { opacity: 0; transform: translateX(48dp); }
    to { opacity: 1; transform: translateX(0dp); }
}
@keyframes return {
    from { opacity: 0; transform: translateX(-48dp); }
    to { opacity: 1; transform: translateX(0dp); }
}
body.entering #panel { animation: 0.18s cubic-out enter; }
body.returning #panel { animation: 0.18s cubic-out return; }

#panel {
    position: absolute;
    left: 120dp;
    top: 60dp;
    width: 720dp;
    padding: 48dp 48dp;
    background-color: #0b1020d8;
    border: 3dp #f0f0f0;
    border-radius: 24dp;
    /* At a larger Text size a tall screen (the main menu) scrolls inside its
       panel instead of running off the bottom of the window. */
    box-sizing: border-box;
    max-height: 90vh;
    overflow-y: auto;
}

.title {
    display: block;
    font-size: 64dp;
    font-weight: bold;
}
/* "BlockPlanet v0.1" under the main menu's title. */
.version {
    display: block;
    font-size: 24dp;
    color: #9aa6c8;
    margin-top: -4dp;
    margin-bottom: 12dp;
}
.subtitle {
    display: block;
    font-size: 26dp;
    color: #e8b818;
    margin-bottom: 24dp;
}

.item {
    display: block;
    font-size: 40dp;
    padding: 10dp 28dp;
    margin-bottom: 4dp;
    border-radius: 14dp;
    transition: background-color 0.12s cubic-out;
}
/* Items in the original orange; the selected one turns white. */
.item { color: #f5821f; }  /* the original #E06018, brightened a little */
.item.focused {
    color: #f8f8f8;
    background-color: #ffffff24;
}
.item .note {
    font-size: 24dp;
    color: #e8b818;
    margin-left: 16dp;
    font-weight: normal;
}
.item.focused .note { color: #e8b818; }


/* Setting rows: label on the left, value on the right. */
.item.value .value {
    float: right;
    color: #e8b818;
}
.item.value.focused .value { color: #f8f8f8; }

/* Long lists scroll inside the panel. */
.list {
    display: block;
    width: 100%;          /* full width, so names do not wrap */
    max-height: 52vh;     /* fits smaller windows; the rest scrolls */
    overflow-y: auto;
}
/* The scrollbar of a long list: a thin orange bar on a faint track. */
scrollbarvertical { width: 8dp; margin-left: 8dp; }
scrollbarvertical slidertrack { background-color: #ffffff14; border-radius: 4dp; }
scrollbarvertical sliderbar { background-color: #f5821fcc; border-radius: 4dp; min-height: 32dp; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { width: 0dp; height: 0dp; }

/* A wider panel, for the name screen's keyboard. */
#panel.wide { width: 860dp; }

/* The name being typed, with a caret. */
.name-field {
    display: block;
    font-size: 56dp;
    font-weight: bold;
    padding: 12dp 24dp;
    margin-bottom: 8dp;
    border-radius: 14dp;
    background-color: #ffffff10;
    min-height: 68dp;
}
.name-field-hint {
    display: block;
    font-size: 24dp;
    color: #e8b818;
    margin-bottom: 20dp;
    min-height: 30dp;
}

/* Grids (data-columns): keys side by side, sized as shares of the row so
   each row holds exactly the grid's column count; wide keys (span2, span4)
   take that many columns. */
.keys .item {
    display: inline-block;
    width: 8%;
    padding: 10dp 0dp;
    margin: 0dp 1.8% 8dp 0dp;
    text-align: center;
    font-size: 34dp;
    background-color: #ffffff10;
}
.keys .item.focused { background-color: #ffffff26; }
.keys .item.span2 { width: 17.8%; font-size: 26dp; padding: 17dp 0dp; }
.keys .item.span4 { width: 37.4%; font-size: 26dp; padding: 17dp 0dp; }
.keys .item.span2, .keys .item.span4 { margin-top: 8dp; }
.tiles .item {
    display: inline-block;
    box-sizing: border-box;
    width: 31%;
    margin-right: 2%;
}
.tiles .item {
    vertical-align: top;
    height: 92dp;
    font-size: 40dp;
}
.tiles .item .note {
    display: block;
    margin-left: 0dp;
    font-size: 24dp;
}

/* Controller-only and keyboard-only parts (body.pad while a controller is used). */
.for-pad { display: none; }
body.pad .for-pad { display: block; }
body.pad .for-keys { display: none; }
.subtitle .for-pad, .subtitle .for-keys { display: inline; }
.subtitle .for-pad { display: none; }
body.pad .subtitle .for-pad { display: inline; }

/* Over the game's own pause background, which already hides the board. */
body.over-pause { background-color: #00000000; }
/* Over the menu grid (ui_grid.h), which is the background itself. */
body.on-grid { background-color: #00000000; }

/* A large heading, for screens shown over play (the pause menu). */
.header {
    display: block;
    font-size: 96dp;
    font-weight: bold;
    letter-spacing: 4dp;
    margin-bottom: 4dp;
}

/* Sliders: a bar beside the value, filled to it (placed absolutely, as
   floats beside the value do not line up in RmlUi). */
.item.slider { position: relative; }
.item.slider .value {
    float: none;
    position: absolute;
    right: 28dp;
    top: 10dp;
}
.item.slider .bar {
    position: absolute;
    right: 150dp;
    top: 31dp;
    width: 200dp;
    height: 10dp;
    border-radius: 5dp;
    background-color: #ffffff26;
}
.item.slider .fill {
    display: block;
    height: 10dp;
    border-radius: 5dp;
    background-color: #f5821f;
}
.item.slider.focused .fill { background-color: #f8f8f8; }


/* What the focused item is (data-description), under the list. */
.description {
    display: block;
    margin-top: 24dp;
    padding: 16dp 28dp;
    min-height: 64dp;
    font-size: 26dp;
    line-height: 34dp;
    color: #c8d0e8;
    font-effect: none;
    background-color: #ffffff10;
    border-radius: 14dp;
}
.description.empty { visibility: hidden; }
/* Chapter and stage lists: no empty description box under the list. */
body.lists .description.empty { display: none; }

/* The Alt button's hint at the end of a description ("[X] Training"). */
.alt-hint { display: block; margin-top: 8dp; color: #e8b818; }

/* Button symbols, as in the HUD's game text (hud.rcss). */
.btn {
    display: inline-block;
    min-width: 1.15em;
    height: 1.15em;
    line-height: 1.15em;
    padding: 0em 0.12em;
    margin: 0em 0.08em;
    text-align: center;
    font-size: 0.8em;
    font-weight: bold;
    color: #f8f8f8;
    font-effect: none;
    vertical-align: middle;
}
.btn.key { border: 0.1em #e8e8f0; border-radius: 0.25em; background-color: #2a2e3c; padding: 0em 0.3em; }
.btn.pad { border-radius: 0.6em; }
.btn.shoulder { background-color: #2a2c34; border: 0.08em #b8bcc8; border-radius: 0.35em 0.35em 0.2em 0.2em; padding: 0em 0.3em; }
.btn.nx { background-color: #3a3c44; border: 0.08em #d8d8e0; }
.btn.ps { background-color: #1e2028; border: 0.08em #9098b0; position: relative; width: 1.15em; padding: 0em; }
.ps-cross, .ps-circle, .ps-square, .ps-triangle { display: block; position: absolute; }
/* The d-pad: a light cross on a dark cap. */
.btn.dpad { background-color: #2a2c34; border: 0.08em #b8bcc8; position: relative; width: 1.15em; padding: 0em; }
.dpad-cross { display: block; position: absolute; left: 0.2em; top: 0.2em; width: 0.75em; height: 0.75em; }
.dpad-cross .arm { display: block; position: absolute; background-color: #e8ecf6; border-radius: 0.05em; }
.dpad-cross .arm.h { left: 0em; top: 0.27em; width: 0.75em; height: 0.21em; }
.dpad-cross .arm.v { left: 0.27em; top: 0em; width: 0.21em; height: 0.75em; }

/* Long lists (the main menu): smaller rows so the description fits. */
body.compact #panel { top: 40dp; padding: 40dp 48dp; }
body.compact .item { font-size: 34dp; padding: 6dp 28dp; margin-bottom: 2dp; }
body.compact .subtitle { margin-bottom: 16dp; }

/* How to Play (pause menu): short paragraphs to read. */
.howto { display: block; margin: 12dp 0dp 20dp 0dp; }
.howto .para { display: block; font-size: 26dp; line-height: 34dp; color: #c8d0e8; margin-bottom: 10dp; }

/* The credits (credits.rml): one centred column that scrolls by itself;
   roles as headings (yellow, bold), names under them (Body). */
/* Centred both ways: 7% of the window above and below; the list fills the rest. */
body.credits #panel { left: 50%; margin-left: -400dp; width: 800dp; top: 7vh; height: 86vh; padding: 40dp 56dp;
                      text-align: center; display: flex; flex-direction: column; box-sizing: border-box; }
body.credits .subtitle { margin-bottom: 28dp; }
.credits-scroll { display: block; flex: 1; overflow-y: auto; }
.credits-scroll scrollbarvertical { width: 0dp; }
.credit-lead, .credit-tail { display: block; height: 58vh; }
.credit-role { display: block; font-size: 30dp; font-weight: bold; color: #e8b818; margin-bottom: 8dp; }
.credit-name { display: block; font-size: 26dp; line-height: 36dp; color: #f0f2f8; }
.credit-gap { display: block; height: 40dp; }
.credit-closing { display: block; font-size: 26dp; font-style: italic; color: #c8d0e8; }
body.credits .hint { margin-top: 28dp; text-align: center; }


/* A screen alone on the screen (Who is playing?): centred. */
body.centred #panel { left: 50%; margin-left: -360dp; top: 26vh; }
body.centred .hint { display: block; margin-top: 20dp; }

/* Menu icons (the owner's request): Lucide's line icons (ISC, licenses/),
   in the item's own colour, before its label. */
.item .icon { font-family: lucide; font-weight: normal; font-style: normal; font-size: 0.9em;
              display: inline-block; width: 1.5em; vertical-align: middle; }
