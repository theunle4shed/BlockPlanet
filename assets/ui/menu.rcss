/* Style: docs/STYLE.md (decided 2026-11-08), shared with the HUD and cards
   (hud.rcss). Every menu text uses one of these roles; sizes in dp, laid out
   for a 1080-pixel-high screen. Graphics > Text size multiplies every dp
   (ui_system.cpp), so whole panels grow evenly.
     Hero      96  bold   the pause menu's Paused (.header)
     Display   64  bold   screen titles (.title)
     Item      40         menu choices (.item); 34 in long lists (body.compact)
     Body      26         descriptions and paragraphs (.description, .howto .para);
                          subtitles in Yellow (.subtitle)
     Note      24         notes beside items, values, hints, the version
   Special cases: the name being typed (56) and the on-screen keyboard (34).
   Colours: items Orange #F5821F, the focused one White #F8F8F8 on a pill
   (no change of weight); notes, values, subtitles and hints Yellow #E8B818;
   descriptions Soft #C8D0E8; the version Muted #9AA6C8. Text inside the
   panel has no outline. */

body {
    width: 100%;
    height: 100%;
    font-family: LatoLatin;
    color: #f8f8f8;
    background-color: #00000080;
    font-effect: none;
}

@keyframes enter {
    from { opacity: 0; transform: translateX(48dp); }
    to { opacity: 1; transform: translateX(0dp); }
}
@keyframes return {
    from { opacity: 0; transform: translateX(-48dp); }
    to { opacity: 1; transform: translateX(0dp); }
}
body.entering #panel { animation: 0.18s cubic-out enter; }
body.returning #panel { animation: 0.18s cubic-out return; }

#panel {
    position: absolute;
    left: 120dp;
    top: 60dp;
    width: 720dp;
    padding: 48dp 48dp;
    background-color: #000000b3;
    border: 3dp #f0f0f0;
    border-radius: 24dp;
    /* At a larger Text size a tall screen (the main menu) scrolls inside its
       panel instead of running off the bottom of the window. */
    box-sizing: border-box;
    max-height: 90vh;
    overflow-y: auto;
}

.title {
    display: block;
    font-size: 64dp;
    font-weight: bold;
}
/* "BlockPlanet v0.1" under the main menu's title. */
.version {
    display: block;
    font-size: 24dp;
    color: #9aa6c8;
    margin-top: -4dp;
    margin-bottom: 12dp;
}
.subtitle {
    display: block;
    font-size: 26dp;
    color: #e8b818;
    margin-bottom: 24dp;
}

.item {
    display: block;
    font-size: 40dp;
    padding: 10dp 28dp;
    margin-bottom: 4dp;
    border-radius: 14dp;
    transition: background-color 0.12s cubic-out;
}
/* Items in the original orange; the selected one turns white. */
.item { color: #f5821f; }  /* the original #E06018, brightened a little */
.item.focused {
    color: #f8f8f8;
    background-color: #ffffff24;
}
.item .note {
    font-size: 24dp;
    color: #e8b818;
    margin-left: 16dp;
    font-weight: normal;
}
.item.focused .note { color: #e8b818; }


/* Setting rows: label on the left, value on the right. */
.item.value .value {
    float: right;
    color: #e8b818;
}
.item.value.focused .value { color: #f8f8f8; }

/* Long lists scroll inside the panel. */
.list {
    display: block;
    width: 100%;          /* full width, so names do not wrap */
    max-height: 52vh;     /* fits smaller windows; the rest scrolls */
    overflow-y: auto;
}
/* The scrollbar of a long list: a thin orange bar on a faint track. */
scrollbarvertical { width: 8dp; margin-left: 8dp; }
scrollbarvertical slidertrack { background-color: #ffffff14; border-radius: 4dp; }
scrollbarvertical sliderbar { background-color: #f5821fcc; border-radius: 4dp; min-height: 32dp; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { width: 0dp; height: 0dp; }

/* A wider panel, for the name screen's keyboard. */
#panel.wide { width: 860dp; }

/* The name being typed, with a caret. */
.name-field {
    display: block;
    font-size: 56dp;
    font-weight: bold;
    padding: 12dp 24dp;
    margin-bottom: 8dp;
    border-radius: 14dp;
    background-color: #ffffff10;
    min-height: 68dp;
}
.name-field-hint {
    display: block;
    font-size: 24dp;
    color: #e8b818;
    margin-bottom: 20dp;
    min-height: 30dp;
}

/* Grids (data-columns): keys side by side, sized as shares of the row so
   each row holds exactly the grid's column count; wide keys (span2, span4)
   take that many columns. */
.keys .item {
    display: inline-block;
    width: 8%;
    padding: 10dp 0dp;
    margin: 0dp 1.8% 8dp 0dp;
    text-align: center;
    font-size: 34dp;
    background-color: #ffffff10;
}
.keys .item.focused { background-color: #ffffff26; }
.keys .item.span2 { width: 17.8%; font-size: 26dp; padding: 17dp 0dp; }
.keys .item.span4 { width: 37.4%; font-size: 26dp; padding: 17dp 0dp; }
.keys .item.span2, .keys .item.span4 { margin-top: 8dp; }
.tiles .item {
    display: inline-block;
    box-sizing: border-box;
    width: 31%;
    margin-right: 2%;
}
.tiles .item {
    vertical-align: top;
    height: 92dp;
    font-size: 40dp;
}
.tiles .item .note {
    display: block;
    margin-left: 0dp;
    font-size: 24dp;
}

/* Controller-only and keyboard-only parts (body.pad while a controller is used). */
.for-pad { display: none; }
body.pad .for-pad { display: block; }
body.pad .for-keys { display: none; }
.subtitle .for-pad, .subtitle .for-keys { display: inline; }
.subtitle .for-pad { display: none; }
body.pad .subtitle .for-pad { display: inline; }

/* Over the game's own pause background, which already hides the board. */
body.over-pause { background-color: #00000000; }
/* Over the menu grid (ui_grid.h), which is the background itself. */
body.on-grid { background-color: #00000000; }

/* A large heading, for screens shown over play (the pause menu). */
.header {
    display: block;
    font-size: 96dp;
    font-weight: bold;
    letter-spacing: 4dp;
    margin-bottom: 4dp;
}

/* Sliders: a bar beside the value, filled to it (placed absolutely, as
   floats beside the value do not line up in RmlUi). */
.item.slider { position: relative; }
.item.slider .value {
    float: none;
    position: absolute;
    right: 28dp;
    top: 10dp;
}
.item.slider .bar {
    position: absolute;
    right: 150dp;
    top: 31dp;
    width: 200dp;
    height: 10dp;
    border-radius: 5dp;
    background-color: #ffffff26;
}
.item.slider .fill {
    display: block;
    height: 10dp;
    border-radius: 5dp;
    background-color: #f5821f;
}
.item.slider.focused .fill { background-color: #f8f8f8; }


/* What the focused item is (data-description), under the list. */
.description {
    display: block;
    margin-top: 24dp;
    padding: 16dp 28dp;
    min-height: 64dp;
    font-size: 26dp;
    line-height: 34dp;
    color: #c8d0e8;
    font-effect: none;
    background-color: #ffffff10;
    border-radius: 14dp;
}
.description.empty { visibility: hidden; }
/* Chapter and stage lists: no empty description box under the list. */
body.lists .description.empty { display: none; }

/* The Alt button's hint at the end of a description ("[X] Training"). */
.alt-hint { display: block; margin-top: 8dp; color: #e8b818; }

/* Button symbols, as in the HUD's game text (hud.rcss). */
.btn {
    display: inline-block;
    min-width: 1.15em;
    height: 1.15em;
    line-height: 1.15em;
    padding: 0em 0.12em;
    margin: 0em 0.08em;
    text-align: center;
    font-size: 0.8em;
    font-weight: bold;
    color: #f8f8f8;
    font-effect: none;
    vertical-align: middle;
}
.btn.key { border: 0.1em #e8e8f0; border-radius: 0.25em; background-color: #2a2e3c; padding: 0em 0.3em; }
.btn.pad { border-radius: 0.6em; }
.btn.shoulder { background-color: #2a2c34; border: 0.08em #b8bcc8; border-radius: 0.35em 0.35em 0.2em 0.2em; padding: 0em 0.3em; }
.btn.nx { background-color: #3a3c44; border: 0.08em #d8d8e0; }
.btn.ps { background-color: #1e2028; border: 0.08em #9098b0; position: relative; width: 1.15em; padding: 0em; }
.ps-cross, .ps-circle, .ps-square, .ps-triangle { display: block; position: absolute; }
/* The d-pad: a light cross on a dark cap. */
.btn.dpad { background-color: #2a2c34; border: 0.08em #b8bcc8; position: relative; width: 1.15em; padding: 0em; }
.dpad-cross { display: block; position: absolute; left: 0.2em; top: 0.2em; width: 0.75em; height: 0.75em; }
.dpad-cross .arm { display: block; position: absolute; background-color: #e8ecf6; border-radius: 0.05em; }
.dpad-cross .arm.h { left: 0em; top: 0.27em; width: 0.75em; height: 0.21em; }
.dpad-cross .arm.v { left: 0.27em; top: 0em; width: 0.21em; height: 0.75em; }

/* Long lists (the main menu): smaller rows so the description fits. */
body.compact #panel { top: 40dp; padding: 40dp 48dp; }
body.compact .item { font-size: 34dp; padding: 6dp 28dp; margin-bottom: 2dp; }
body.compact .subtitle { margin-bottom: 16dp; }

/* How to Play (pause menu): short paragraphs to read. */
.howto { display: block; margin: 12dp 0dp 20dp 0dp; }
.howto .para { display: block; font-size: 26dp; line-height: 34dp; color: #c8d0e8; margin-bottom: 10dp; }

/* The credits (credits.rml): one centred column that scrolls by itself;
   roles as headings (yellow, bold), names under them (Body). */
/* Centred both ways: 7% of the window above and below; the list fills the rest. */
body.credits #panel { left: 50%; margin-left: -400dp; width: 800dp; top: 7vh; height: 86vh; padding: 40dp 56dp;
                      text-align: center; display: flex; flex-direction: column; box-sizing: border-box; }
body.credits .subtitle { margin-bottom: 28dp; }
.credits-scroll { display: block; flex: 1; overflow-y: auto; }
.credits-scroll scrollbarvertical { width: 0dp; }
.credit-lead, .credit-tail { display: block; height: 58vh; }
.credit-role { display: block; font-size: 30dp; font-weight: bold; color: #e8b818; margin-bottom: 8dp; }
.credit-name { display: block; font-size: 26dp; line-height: 36dp; color: #f0f2f8; }
.credit-gap { display: block; height: 40dp; }
.credit-closing { display: block; font-size: 26dp; font-style: italic; color: #c8d0e8; }
body.credits .hint { margin-top: 28dp; text-align: center; }


/* A screen alone on the screen (Who is playing?): centred. */
body.centred #panel { left: 50%; margin-left: -360dp; top: 26vh; }
/* Taller than wide: every panel fits the window's width instead of running
   off its right edge (the fixed 720dp panel is wider than a narrow window). */
@media (orientation: portrait) {
    #panel, body.lab #panel { left: 4vw; width: 92vw; }
    body.centred #panel { left: 4vw; margin-left: 0dp; }
}
body.centred .hint { display: block; margin-top: 20dp; }

/* Who is playing? and the main menu share one panel (the owner's request,
   2026-11-10): the same place, size and heading, so going from one to the
   other changes the panel's contents instead of bringing in a new panel. */
@keyframes swap {
    from { opacity: 0.4; }
    to { opacity: 1; }
}
body.shared.entering #panel, body.shared.returning #panel { animation: 0.12s cubic-out swap; }
body.shared .hint { display: block; margin-top: 20dp; }
/* Taller than wide: the shared panel fits the window's width. */
@media (orientation: portrait) {
    body.shared #panel { left: 4vw; width: 92vw; }
}

/* Menu icons (the owner's request): Lucide's line icons (ISC, licenses/),
   in the item's own colour, before its label. */
.item .icon { font-family: lucide; font-weight: normal; font-style: normal; font-size: 0.9em;
              display: inline-block; width: 1.5em; vertical-align: middle; }

/* Pictures before a label (profile coins): about the text's height. */
.item img.picture { width: 1.1em; height: 1.1em; vertical-align: middle; margin-right: 0.4em; }
/* The coin screen: five to a row, pictures only. The colour step: four to
   a row, each coin above its colour's name. */
.tiles.coins .item { width: 18%; height: 100dp; font-size: 24dp; text-align: center; padding: 8dp 2dp; }
.tiles.coins .item img.picture { display: block; width: 76dp; height: 76dp; margin: 4dp auto 0dp auto; }
.tiles.coins.named .item { width: 23%; height: 132dp; }
.tiles.coins.named .item img.picture { margin-bottom: 4dp; }

/* Development status beside each menu item (the owner's request, 2026-11-14:
   the main build shows every menu as if unlocked, with each item's state). */
.item .rag { font-size: 20dp; margin-left: 12dp; }
.item .rag.not-started { color: #e85a5a; }
.item .rag.in-progress { color: #e8b818; }
.item .rag.viable { color: #5bd16a; }
/* The same on items the game lists (their note, by the item's class). */
.item.rag-not-started .note, .item.rag-not-started.focused .note { color: #e85a5a; }
.item.rag-in-progress .note, .item.rag-in-progress.focused .note { color: #e8b818; }
.item.rag-viable .note, .item.rag-viable.focused .note { color: #5bd16a; }

/* The main menu's row of icons (Profiles, Trophies, Options, Exit), right
   aligned under the last item with a little space above (the owner's layout). */
.list.icon-row { text-align: right; margin-top: 28dp; }
.list.icon-row .item { display: inline-block; width: auto; padding: 8dp 14dp; margin-left: 8dp; }
.list.icon-row .item .icon { margin: 0dp; font-size: 1.15em; }

/* Results (a stage played on its own): the time or score against the best. */
.result { display: block; font-size: 40dp; font-weight: bold; color: #f8f8f8; margin-top: 8dp; padding-bottom: 28dp; }
.goal { display: block; font-size: 26dp; color: #e8e8ee; margin-top: 10dp; padding-bottom: 32dp; }

/* The grid test screen: a narrow panel at the left, leaving the grid in view. */
body.lab #panel { left: 40dp; width: 640dp; top: 20dp; padding: 28dp 36dp; max-height: 96vh; }
body.lab .item { font-size: 26dp; padding: 3dp 20dp; }
body.lab .description { font-size: 22dp; }
body.lab .item.slider .value { top: 3dp; right: 20dp; }
body.lab .item.slider .bar { top: 15dp; right: 120dp; width: 180dp; height: 8dp; }
body.lab .item.slider .fill { height: 8dp; }

/* The jukebox (jukebox.rml, jukebox_list.rml): a player in the middle of the
   screen, Winamp-inspired, in the menus' colours. A head bar, a dark display
   (time, track, spectrum), the transport buttons as a grid, then the volume. */
#panel.player {
    left: 50%;
    margin-left: -440dp;
    width: 880dp;
    top: 50%;
    margin-top: -350dp;
    padding: 0dp 0dp 24dp 0dp;
    overflow-y: hidden;
}
#panel.player.playlist { margin-top: -400dp; }
#panel.player .list, #panel.player .item.player-volume, #panel.player .description { margin-left: 32dp; margin-right: 32dp; width: auto; }
.player-head {
    display: block;
    font-size: 30dp;
    font-weight: bold;
    padding: 14dp 32dp;
    margin-bottom: 20dp;
    background-color: #ffffff1a;
    border-radius: 21dp 21dp 0dp 0dp;
}
.player-head .icon { font-family: lucide; font-weight: normal; margin-right: 14dp; color: #e8b818; }
.player-sub { font-size: 22dp; font-weight: normal; color: #9aa6c8; margin-left: 18dp; }
.player-display {
    display: block;
    margin: 0dp 32dp 20dp 32dp;
    padding: 18dp 24dp;
    height: 200dp;
    position: relative;
    background-color: #050a18e6;
    border: 2dp #2c3e78;
    border-radius: 14dp;
}
.player-left { position: absolute; left: 24dp; top: 18dp; width: 230dp; height: 200dp; }
.player-right { position: absolute; left: 270dp; right: 24dp; top: 18dp; display: block; }
.player-state { display: block; font-family: lucide; font-size: 30dp; color: #e8b818; }
.player-time {
    display: block;
    font-size: 84dp;
    font-weight: bold;
    color: #e8b818;
    margin-top: 6dp;
}
.player-track {
    display: block;
    font-size: 36dp;
    font-weight: bold;
    color: #f8f8f8;
    white-space: nowrap;
    overflow: hidden;
    height: 46dp;
}
.player-number { color: #f5821f; margin-right: 16dp; }
.player-info { display: block; font-size: 22dp; color: #9aa6c8; margin-top: 2dp; }
/* The bars stand on a fixed baseline and grow upwards. */
.player-spectrum { display: flex; flex-direction: row; align-items: flex-end; height: 96dp; margin-top: 10dp; }
.player-spectrum .band {
    display: block;
    flex: 0 0 auto;
    width: 22dp;
    height: 4dp;
    margin-right: 6dp;
    background-color: #f5821f;
    border-radius: 3dp 3dp 0dp 0dp;
}
.player-modes { display: block; font-size: 20dp; color: #e8b818; margin-top: 4dp; }

/* The transport buttons: a 4 by 2 grid of keys, icon over label; a lit key
   (playing, Shuffle on, Repeat on) has a yellow icon. */
.player-controls .item.player-button {
    display: inline-block;
    box-sizing: border-box;
    width: 11.5%;
    margin: 0dp 1% 10dp 0dp;
    padding: 10dp 0dp 8dp 0dp;
    text-align: center;
    font-size: 20dp;
    background-color: #ffffff10;
}
.player-controls .item.player-button .icon { display: block; width: auto; text-align: center; font-size: 40dp; margin: 0dp 0dp 4dp 0dp; }
.player-controls .item.player-button.lit .icon { color: #e8b818; }
.player-controls .item.player-button.focused { background-color: #ffffff2c; }
.player-controls .item.player-button.focused .icon { color: #f8f8f8; }
.item.player-volume { font-size: 32dp; margin-top: 6dp; }
.item.player-volume .icon { margin-right: 14dp; }
body.jukebox .list { max-height: 60vh; }

/* The jukebox's visualisers (src/ui/ui_jukebox.cpp): a full-screen layer
   behind the player, of the game's bricks. Dark when a full-screen one is on. */
#jbvis { position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; z-index: 0; }
body.jukebox #panel { z-index: 1; }
#jbvis.full { background-color: #03060f; }
#jbvis.cover { background-color: #000000; }  /* while a game-drawn background is set up */
#jbvis .jbbrick { position: absolute; }
#jbvis .jbpiece { position: absolute; display: none; }
#jbvis .jbpiece .jbbrick { width: 25%; height: 25%; }
/* Hide: only the background, with a hint that fades out. */
.player-hint { display: none; }
body.player-hidden #panel { visibility: hidden; }
body.player-hidden .player-hint {
    display: block;
    position: absolute;
    left: 0dp;
    right: 0dp;
    bottom: 40dp;
    text-align: center;
    font-size: 24dp;
    color: #9aa6c8;
    animation: 4s cubic-in hint-fade;
    opacity: 0;
}
@keyframes hint-fade { 0% { opacity: 1; } 60% { opacity: 1; } 100% { opacity: 0; } }
