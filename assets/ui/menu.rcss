/* BlockPlanet menus: placeholder style until the art direction is set
   (docs/UI.md). Sizes are in dp, laid out for a 1080-pixel-high screen. */

body {
    width: 100%;
    height: 100%;
    font-family: LatoLatin;
    color: #f2f5ff;
    background-color: #05081080;
}

@keyframes enter {
    from { opacity: 0; transform: translateX(48dp); }
    to { opacity: 1; transform: translateX(0dp); }
}
@keyframes return {
    from { opacity: 0; transform: translateX(-48dp); }
    to { opacity: 1; transform: translateX(0dp); }
}
body.entering #panel { animation: 0.18s cubic-out enter; }
body.returning #panel { animation: 0.18s cubic-out return; }

#panel {
    position: absolute;
    left: 120dp;
    top: 140dp;
    width: 720dp;
    padding: 48dp 56dp;
    background-color: #0b1020e0;
    border-radius: 28dp;
}

.title {
    display: block;
    font-size: 72dp;
    font-weight: bold;
}
.subtitle {
    display: block;
    font-size: 28dp;
    color: #a9b4d6;
    margin-bottom: 36dp;
}

.item {
    display: block;
    font-size: 44dp;
    padding: 14dp 28dp;
    margin-bottom: 6dp;
    border-radius: 14dp;
    transition: background-color 0.12s cubic-out;
}
.item.focused {
    background-color: #3a6df0;
    font-weight: bold;
}
.item .note {
    font-size: 24dp;
    color: #a9b4d6;
    margin-left: 16dp;
    font-weight: normal;
}
.item.focused .note { color: #dce6ff; }

.hint {
    display: block;
    margin-top: 32dp;
    font-size: 24dp;
    color: #7f8bb0;
}
