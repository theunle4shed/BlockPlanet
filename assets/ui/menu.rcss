/* BlockPlanet menus: placeholder style until the art direction is set
   (docs/UI.md). Sizes are in dp, laid out for a 1080-pixel-high screen. */

body {
    width: 100%;
    height: 100%;
    font-family: LatoLatin;
    color: #f2f5ff;
    background-color: #05081080;
}

@keyframes enter {
    from { opacity: 0; transform: translateX(48dp); }
    to { opacity: 1; transform: translateX(0dp); }
}
@keyframes return {
    from { opacity: 0; transform: translateX(-48dp); }
    to { opacity: 1; transform: translateX(0dp); }
}
body.entering #panel { animation: 0.18s cubic-out enter; }
body.returning #panel { animation: 0.18s cubic-out return; }

#panel {
    position: absolute;
    left: 120dp;
    top: 140dp;
    width: 720dp;
    padding: 48dp 56dp;
    background-color: #0b1020e0;
    border-radius: 28dp;
}

.title {
    display: block;
    font-size: 72dp;
    font-weight: bold;
}
.subtitle {
    display: block;
    font-size: 28dp;
    color: #a9b4d6;
    margin-bottom: 36dp;
}

.item {
    display: block;
    font-size: 44dp;
    padding: 14dp 28dp;
    margin-bottom: 6dp;
    border-radius: 14dp;
    transition: background-color 0.12s cubic-out;
}
.item.focused {
    background-color: #3a6df0;
    font-weight: bold;
}
.item .note {
    font-size: 24dp;
    color: #a9b4d6;
    margin-left: 16dp;
    font-weight: normal;
}
.item.focused .note { color: #dce6ff; }

.hint {
    display: block;
    margin-top: 32dp;
    font-size: 24dp;
    color: #7f8bb0;
}

/* Setting rows: label on the left, value on the right. */
.item.value .value {
    float: right;
    color: #ffd166;
}
.item.value.focused .value { color: #ffffff; }

/* Long lists scroll inside the panel. */
.list {
    display: block;
    max-height: 600dp;
    overflow-y: auto;
}

/* A wider panel, for the name screen's keyboard. */
#panel.wide { width: 860dp; }

/* The name being typed, with a caret. */
.name-field {
    display: block;
    font-size: 56dp;
    font-weight: bold;
    padding: 12dp 24dp;
    margin-bottom: 8dp;
    border-radius: 14dp;
    background-color: #ffffff14;
    min-height: 68dp;
}
.name-field-hint {
    display: block;
    font-size: 24dp;
    color: #ffd166;
    margin-bottom: 20dp;
    min-height: 30dp;
}

/* Grids (data-columns): keys side by side, sized as shares of the row so
   each row holds exactly the grid's column count; wide keys (span2, span4)
   take that many columns. */
.keys .item {
    display: inline-block;
    width: 8%;
    padding: 10dp 0dp;
    margin: 0dp 1.8% 8dp 0dp;
    text-align: center;
    font-size: 34dp;
    background-color: #ffffff0c;
}
.keys .item.focused { background-color: #3a6df0; }
.keys .item.span2 { width: 17.8%; font-size: 26dp; padding: 17dp 0dp; }
.keys .item.span4 { width: 37.4%; font-size: 26dp; padding: 17dp 0dp; }
.keys .item.span2, .keys .item.span4 { margin-top: 8dp; }
.tiles .item {
    display: inline-block;
    box-sizing: border-box;
    width: 31%;
    margin-right: 2%;
}
.tiles .item {
    vertical-align: top;
    height: 92dp;
    font-size: 40dp;
}
.tiles .item .note {
    display: block;
    margin-left: 0dp;
    font-size: 22dp;
}

/* Controller-only and keyboard-only parts (body.pad while a controller is used). */
.for-pad { display: none; }
body.pad .for-pad { display: block; }
body.pad .for-keys { display: none; }
.subtitle .for-pad, .subtitle .for-keys { display: inline; }
.subtitle .for-pad { display: none; }
body.pad .subtitle .for-pad { display: inline; }

/* Over the game's own pause background, which already hides the board. */
body.over-pause { background-color: #00000000; }
