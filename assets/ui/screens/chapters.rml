<rml>
<head>
    <title>Rescue</title>
    <link type="text/rcss" href="../menu.rcss"/>
</head>
<body data-grid="green" class="compact lists">
    <div id="panel">
        <div class="title" data-text="chapters_title">Rescue</div>
        <div class="subtitle" data-text="chapters_subtitle">Choose an episode</div>
        <div class="list" data-list="chapters"></div>
        <div class="list icon-row"><div class="item" id="back" data-action="back" data-description="Back"><span class="icon">&#xE2A1;</span></div></div>
        <div id="description" class="description empty"></div>
    </div>
</body>
</rml>
