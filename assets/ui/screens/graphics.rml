<rml>
<head>
    <title>Graphics</title>
    <link type="text/rcss" href="../menu.rcss"/>
</head>
<body class="compact">
    <div id="panel">
        <div class="title">Graphics</div>
        <div class="subtitle">Changes apply and save straight away</div>
        <div class="item value" id="sphere" data-description="Extended draws more of the sphere around the play area. Original draws only the patch the N64 showed." data-setting="sphere"
             data-options="extended:Extended,original:Original">Sphere<span class="value"></span></div>
        <div class="item value" id="aspect" data-description="How the picture fits your screen: Fill window uses its whole width, 16:9 is widescreen, 4:3 is the original shape." data-setting="aspect"
             data-options="fill:Fill window,16x9:16:9,4x3:4:3">Picture<span class="value"></span></div>
        <div class="item value" id="window" data-description="Play in a window or full screen. F11 or Alt+Enter also switches." data-setting="window"
             data-options="windowed:Window,fullscreen:Full screen">Display<span class="value"></span></div>
        <div class="item value" id="texture_filter" data-description="Three-point smooths textures the way the N64 did. Linear is the usual PC smoothing." data-setting="texture_filter"
             data-options="three-point:Three-point,linear:Linear">Textures<span class="value"></span></div>
        <div class="item value" id="presentation_filter" data-description="How the finished picture is scaled to your screen: Pixel keeps edges crisp and even, Smooth softens them, Sharp uses the nearest pixels." data-setting="presentation_filter"
             data-options="pixel:Pixel,linear:Smooth,nearest:Sharp">Scaling<span class="value"></span></div>
        <div class="item value" id="hud_distance" data-description="Where the score, hearts and other panels sit: near the sphere, at the screen edges, or moving with the sphere." data-setting="hud_distance"
             data-options="near:Near the sphere,edges:Screen edges,follow:Follow the sphere">HUD panels<span class="value"></span></div>
        <div class="item value" id="text_size" data-description="The size of the text on cards and in Training, Wheels’ speech included." data-setting="text_size"
             data-options="small:Small,default:Default,large:Large,larger:Larger">Text size<span class="value"></span></div>
        <div class="item" id="back" data-action="back">Back</div>
        <div id="description" class="description"></div>
    </div>
</body>
</rml>
