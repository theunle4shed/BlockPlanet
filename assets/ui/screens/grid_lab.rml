<rml>
<head>
    <title>Grid test</title>
    <link type="text/rcss" href="../menu.rcss"/>
</head>
<!-- A temporary screen for tuning the menu grid by eye (the owner's request,
     2026-11-09; docs/UI.md, Menu grid). Its settings change the grid at once
     and are not saved; each change is written to the log ("grid_tuning"). -->
<body class="compact lab" data-grid="blue">
    <div id="panel">
        <div class="title">Grid test</div>
        <div class="subtitle">For tuning. Not saved: note the values you like.</div>
        <div class="item value" id="grid_theme" data-setting="grid_theme" data-description="The grid's colour."
             data-options="blue:Blue,green:Green,red:Red,purple:Purple,gold:Gold,grey:Grey,cyan:Cyan,teal:Teal,peach:Peach,pause:Pause cycle">Colour<span class="value"></span></div>
        <div class="item value" id="grid_show" data-setting="grid_show" data-description="Show the tiles, the background colour behind them, or both."
             data-options="both:Tiles and background,tiles:Tiles only,background:Background only">Show<span class="value"></span></div>
        <div class="item" id="fly_in" data-action="command:grid_fly_in" data-description="Fly the tiles in.">Fly in</div>
        <div class="item" id="fly_out" data-action="command:grid_fly_out" data-description="Fly the tiles out (the game shows behind).">Fly out</div>
        <div class="item value slider" id="grid_wave_every" data-setting="grid_wave_every" data-description="How long one tile takes to rise and sink once (the water's wave period)."
             data-options="0.5:0.5 s,0.75:0.75 s,1:1 s,1.25:1.25 s,1.5:1.5 s,2:2 s,2.5:2.5 s,3:3 s,4:4 s,5:5 s,6:6 s,8:8 s,10:10 s">Wave period<span class="value"></span><div class="bar"><div class="fill"></div></div></div>
        <div class="item value slider" id="grid_wave_step" data-setting="grid_wave_step" data-description="How long each next tile waits before it rises (the wave starts at the top left)."
             data-options="0:0 ms,10:10 ms,20:20 ms,30:30 ms,40:40 ms,50:50 ms,60:60 ms,80:80 ms,100:100 ms,120:120 ms,150:150 ms,200:200 ms,250:250 ms,300:300 ms,400:400 ms,500:500 ms">Wave tile delay<span class="value"></span><div class="bar"><div class="fill"></div></div></div>
        <div class="item value slider" id="grid_ripple" data-setting="grid_ripple" data-description="A second, weaker ripple crossing the main wave at an angle, as on water (how strong, against the main wave)."
             data-options="0:0 %,10:10 %,20:20 %,35:35 %,50:50 %,75:75 %,100:100 %">Cross ripple<span class="value"></span><div class="bar"><div class="fill"></div></div></div>
        <div class="item value slider" id="grid_wave_depth" data-setting="grid_wave_depth" data-description="How far a tile rises and sinks, in a tile's width."
             data-options="0:0 %,2:2 %,4:4 %,5:5 %,6:6 %,8:8 %,10:10 %,15:15 %,20:20 %,30:30 %">Wave height<span class="value"></span><div class="bar"><div class="fill"></div></div></div>
        <div class="item" id="back" data-action="back">Back</div>
        <div id="description" class="description"></div>
    </div>
</body>
</rml>
