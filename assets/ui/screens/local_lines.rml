<rml>
<head>
    <title>Lines for two</title>
    <link type="text/rcss" href="../menu.rcss"/>
</head>
<body>
    <div id="panel">
        <div class="title">Lines</div>
        <div class="subtitle">Two players</div>
        <div class="item" id="versus" data-action="command:lines_versus" data-description="Lines against a friend or the computer."><span class="icon"></span>Versus<span class="note">coming later</span></div>
        <div class="item" id="cooperative" data-action="command:lines_cooperative" data-description="Lines with a friend or the computer on one sphere."><span class="icon"></span>Cooperative<span class="note">coming later</span></div>
        <div class="item" id="back" data-action="back">Back</div>
        <div id="description" class="description"></div>
    </div>
</body>
</rml>
