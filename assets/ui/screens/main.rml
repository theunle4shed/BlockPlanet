<rml>
<head>
    <title>Main menu</title>
    <link type="text/rcss" href="../menu.rcss"/>
</head>
<body data-grid="blue" class="compact shared" data-back="command:back_to_profiles">
    <div id="panel">
        <div class="title">Tetrisphere™</div>
        <div class="version" id="version"></div>
        <div class="subtitle">Main menu</div>
        <div data-list="continue"></div>
        <div class="item" id="solo" data-action="open:solo" data-description="Play on your own: Story and its modes, Hide &amp; Seek, Puzzle and Lines."><span class="icon"></span>Solo</div>
        <div class="item" id="local" data-action="open:local" data-description="Play with friends on this PC."><span class="icon"></span>Local</div>
        <div class="item" id="online" data-action="open:online" data-description="Play with friends and others over the internet."><span class="icon"></span>Online<span class="note">coming later</span></div>
        <div class="item" id="profiles" data-action="command:profiles" data-description="Choose who is playing, or add a profile."><span class="icon"></span>Profiles</div>
        <div class="item" id="media" data-action="command:media_player"><span class="icon"></span>Media Player<span class="note">coming later</span></div>
        <div class="item" id="trophies" data-action="command:trophies"><span class="icon"></span>Trophies<span class="note">coming later</span></div>
        <div class="item" id="options" data-action="open:options" data-description="Graphics, sound, controls and more."><span class="icon"></span>Options</div>
        <div class="item" id="credits" data-action="command:credits" data-description="The people who made Tetrisphere."><span class="icon"></span>Credits</div>
        <div class="item" id="exit" data-action="command:exit"><span class="icon"></span>Exit to Desktop</div>
        <div id="description" class="description"></div>
    </div>
</body>
</rml>
