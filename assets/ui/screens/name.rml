<rml>
<head>
    <title>Name</title>
    <link type="text/rcss" href="../menu.rcss"/>
</head>
<body>
    <div id="panel" class="wide">
        <div class="title">Name</div>
        <div class="subtitle"><span class="for-keys">Type a name. Enter finishes, Esc cancels.</span><span class="for-pad">Choose letters. Start finishes, B cancels.</span></div>
        <div class="name-field" data-text="name_edit"></div>
        <div class="name-field-hint" data-text="name_hint"></div>
        <div class="keys for-pad" data-list="keyboard" data-columns="10" data-wrap></div>
    </div>
</body>
</rml>
