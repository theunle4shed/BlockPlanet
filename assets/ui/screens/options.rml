<rml>
<head>
    <title>Options</title>
    <link type="text/rcss" href="../menu.rcss"/>
</head>
<body>
    <div id="panel">
        <div class="title">Options</div>
        <div class="subtitle">Settings for this PC and your profile</div>
        <div class="item" id="graphics" data-action="open:graphics">Graphics</div>
        <div class="item" id="audio" data-action="command:audio_screen">Audio</div>
        <div class="item" id="back" data-action="back">Back</div>
    </div>
</body>
</rml>
