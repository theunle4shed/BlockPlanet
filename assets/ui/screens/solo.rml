<rml>
<head>
    <title>Solo</title>
    <link type="text/rcss" href="../menu.rcss"/>
</head>
<body>
    <div id="panel">
        <div class="title">Solo</div>
        <div class="subtitle">Play on your own</div>
        <div class="item" id="story" data-action="command:story">Story</div>
        <div class="item" id="time_trial" data-action="command:time_trial">Score Attack</div>
        <div class="item" id="lines" data-action="command:lines">Lines</div>
        <div class="item" id="puzzle" data-action="command:puzzle">Puzzle</div>
        <div class="item" id="custom" data-action="command:custom">Custom</div>
        <div class="item" id="back" data-action="back">Back</div>
    </div>
</body>
</rml>
