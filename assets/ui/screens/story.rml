<rml>
<head>
    <title>Rescue</title>
    <link type="text/rcss" href="../menu.rcss"/>
</head>
<body data-grid="green">
    <div id="panel">
        <div class="title">Rescue</div>
        <div class="subtitle">Choose how to play</div>
        <div class="item" id="campaign" data-action="command:story" data-alt="command:training_story" data-alt-label="Training" data-description="The story, episode by episode. Open each sphere's core before the blocks reach you."><span class="icon"></span>Campaign</div>
        <div class="item" id="time_attack" data-action="command:time_attack" data-description="Rescue's episodes as fast as you can, against your best time for every stage. A whole episode or one stage."><span class="icon"></span>Time Attack</div>
        <div class="item" id="score_attack" data-action="command:score_attack" data-description="As many points as you can on Rescue's stages, against the clock. Combos add time, and time left becomes points."><span class="icon"></span>Score Attack</div>
        <div class="item" id="casual" data-action="command:casual" data-alt="command:training_story" data-alt-label="Training" data-description="Rescue without a game over: lost hearts come back. No records or trophies."><span class="icon"></span>Casual</div>
        <div class="item" id="back" data-action="back">Back</div>
        <div id="description" class="description"></div>
    </div>
</body>
</rml>
