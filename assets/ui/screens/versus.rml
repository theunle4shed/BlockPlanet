<rml>
<head>
    <title>Versus</title>
    <link type="text/rcss" href="../menu.rcss"/>
</head>
<body data-grid="green">
    <div id="panel">
        <div class="title">Versus</div>
        <div class="subtitle">Who is player 2?</div>
        <div class="item" id="computer" data-action="command:versus" data-description="Play against the computer.">Computer</div>
        <div class="item" id="person" data-action="command:versus_people" data-description="A friend on a second controller, split screen.">A second player<span class="note">coming later</span></div>
        <div class="item" id="back" data-action="back">Back</div>
        <div id="description" class="description"></div>
    </div>
</body>
</rml>
