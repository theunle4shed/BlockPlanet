<rml>
<head>
    <title>Toast</title>
    <style>
        body { width: 100%; height: 100%; font-family: LatoLatin; pointer-events: none; }
        /* A short note that fades by itself (ui_system.h, show_toast): the menus'
           note colour on a panel like theirs, low in the middle. */
        #toast { position: absolute; left: 0; right: 0; bottom: 9vh; text-align: center; }
        #text { display: inline-block; padding: 1.2vh 2.4vh; font-size: 2.6vh; color: #e8b818;
                background-color: #0b1220e6; border: 0.25vh #f8f8f8; border-radius: 1.2vh;
                font-effect: outline(1px #000000aa); }
    </style>
</head>
<body><div id="toast"><span id="text"></span></div></body>
</rml>
